 Two tasks, each with configuration the other must not see, and two
 conditions that declare none at all. Written in the order a real pipeline
 is written in: definitions after the workflow that refers to them.
-->
<cas:workflows xmlns="http://oodt.jpl.nasa.gov/2.0/cas"
  xmlns:cas="http://oodt.jpl.nasa.gov/2.0/cas">

  <workflow id="urn:test:Pipeline" name="Pipeline" execution="sequential">
    <workflow id="urn:test:Second" name="Second" execution="sequential">
      <conditions execution="sequential" type="pre">
        <condition id-ref="urn:test:First"/>
        <condition id-ref="urn:test:Then"/>
      </conditions>
      <task id-ref="urn:test:Aggregate"/>
    </workflow>
  </workflow>

  <task id="urn:test:Partition" name="Partition"
        class="org.example.PartitionTask">
    <conditions/>
    <configuration>
      <property name="OnlyOnPartition" value="partition-value"/>
      <property name="Shared" value="from-partition"/>
    </configuration>
  </task>

  <task id="urn:test:Aggregate" name="Aggregate"
        class="org.example.AggregateTask">
    <conditions/>
    <configuration>
      <property name="OnlyOnAggregate" value="aggregate-value"/>
      <property name="Shared" value="from-aggregate"/>
    </configuration>
  </task>

  <condition id="urn:test:First" name="First"
             class="org.example.FirstCondition"/>
  <condition id="urn:test:Then" name="Then"
             class="org.example.ThenCondition"/>

</cas:workflows>
