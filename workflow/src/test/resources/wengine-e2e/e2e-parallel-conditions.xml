<!--
  Two sequential workflows differing only in the execution attribute on their
  pre-condition block, which is the whole of what is under test. The shipped
  GranuleMaps.xml has the same shape: three independent daily-file checks that
  need not be serialised.
-->
<cas:workflows xmlns="http://oodt.jpl.nasa.gov/2.0/cas"
  xmlns:cas="http://oodt.jpl.nasa.gov/2.0/cas">

  <sequential id="urn:oodt:e2e:ParallelConds" name="Parallel Conditions">
    <conditions execution="parallel" type="pre">
      <condition id-ref="urn:oodt:e2e:ProbeA"/>
      <condition id-ref="urn:oodt:e2e:ProbeB"/>
      <condition id-ref="urn:oodt:e2e:ProbeC"/>
    </conditions>
    <task id-ref="urn:oodt:e2e:AfterProbes"/>
  </sequential>

  <sequential id="urn:oodt:e2e:SequentialConds" name="Sequential Conditions">
    <conditions execution="sequential" type="pre">
      <condition id-ref="urn:oodt:e2e:ProbeA"/>
      <condition id-ref="urn:oodt:e2e:ProbeB"/>
      <condition id-ref="urn:oodt:e2e:ProbeC"/>
    </conditions>
    <task id-ref="urn:oodt:e2e:AfterProbes"/>
  </sequential>

  <task id="urn:oodt:e2e:AfterProbes" name="After Probes"
        class="org.apache.oodt.cas.workflow.engine.RecordingTask">
    <conditions/>
    <configuration>
      <property name="RecordAs" value="after-probes"/>
    </configuration>
  </task>

  <condition id="urn:oodt:e2e:ProbeA" name="Probe A"
             class="org.apache.oodt.cas.workflow.engine.ConcurrencyProbeCondition"/>
  <condition id="urn:oodt:e2e:ProbeB" name="Probe B"
             class="org.apache.oodt.cas.workflow.engine.ConcurrencyProbeCondition"/>
  <condition id="urn:oodt:e2e:ProbeC" name="Probe C"
             class="org.apache.oodt.cas.workflow.engine.ConcurrencyProbeCondition"/>

</cas:workflows>
