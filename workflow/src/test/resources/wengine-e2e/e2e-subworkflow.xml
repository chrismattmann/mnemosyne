<!--
  The generic spelling of a sub-workflow: <workflow> names its execution
  strategy in an attribute rather than in the tag. Equivalent to writing
  <sequential> or <parallel>, and nests the same way.
-->
<cas:workflows xmlns:cas="http://oodt.jpl.nasa.gov/1.0/cas">

  <workflow id="urn:oodt:e2e:GenericOuter" name="Generic Outer"
            execution="sequential">
    <task id-ref="urn:oodt:e2e:StepOne"/>
    <workflow id="urn:oodt:e2e:GenericInner" name="Generic Inner"
              execution="sequential">
      <task id-ref="urn:oodt:e2e:StepTwo"/>
    </workflow>
  </workflow>

  <!--
    execution="parallel" has to behave exactly as a <parallel> element does:
    the repository dissolves such a workflow into one dynamic workflow per
    task, so it does not appear under its own id.
  -->
  <workflow id="urn:oodt:e2e:GenericParallel" name="Generic Parallel"
            execution="parallel">
    <task id-ref="urn:oodt:e2e:StepTwo"/>
    <task id-ref="urn:oodt:e2e:StepThree"/>
  </workflow>

  <task id="urn:oodt:e2e:StepOne" name="Step One"
        class="org.apache.oodt.cas.workflow.examples.NoOpTask">
    <conditions/>
  </task>

  <task id="urn:oodt:e2e:StepTwo" name="Step Two"
        class="org.apache.oodt.cas.workflow.examples.NoOpTask">
    <conditions/>
  </task>

  <task id="urn:oodt:e2e:StepThree" name="Step Three"
        class="org.apache.oodt.cas.workflow.examples.NoOpTask">
    <conditions/>
  </task>

</cas:workflows>
