<!--
  The smallest workflow that still proves something end to end: two tasks that
  must run, in order, through the queue-based engine.
-->
<cas:workflows xmlns="http://oodt.jpl.nasa.gov/2.0/cas"
  xmlns:cas="http://oodt.jpl.nasa.gov/2.0/cas">

  <sequential id="urn:oodt:e2e:TwoStep" name="Two Step">
    <task id-ref="urn:oodt:e2e:First"/>
    <task id-ref="urn:oodt:e2e:Second"/>
  </sequential>

  <task id="urn:oodt:e2e:First" name="First"
        class="org.apache.oodt.cas.workflow.engine.RecordingTask">
    <conditions/>
    <configuration>
      <property name="RecordAs" value="first"/>
    </configuration>
  </task>

  <task id="urn:oodt:e2e:Second" name="Second"
        class="org.apache.oodt.cas.workflow.engine.RecordingTask">
    <conditions/>
    <configuration>
      <property name="RecordAs" value="second"/>
    </configuration>
  </task>

</cas:workflows>
