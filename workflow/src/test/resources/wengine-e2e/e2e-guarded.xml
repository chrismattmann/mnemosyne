<!--
  Conditions, which the repository rewrites before the engine sees them: a
  condition written on a workflow is hoisted into a generated task placed
  first, because the engine enforces conditions on tasks and not on workflows.
-->
<cas:workflows xmlns="http://oodt.jpl.nasa.gov/2.0/cas"
  xmlns:cas="http://oodt.jpl.nasa.gov/2.0/cas">

  <!-- A condition on the workflow itself. -->
  <sequential id="urn:oodt:e2e:GuardedWorkflow" name="Guarded Workflow">
    <conditions>
      <condition id-ref="urn:oodt:e2e:Gate"/>
    </conditions>
    <task id-ref="urn:oodt:e2e:Guarded"/>
  </sequential>

  <!-- A condition on the task instead, which is the form the engine runs. -->
  <sequential id="urn:oodt:e2e:GuardedTaskWorkflow" name="Guarded Task">
    <task id-ref="urn:oodt:e2e:GuardedTask"/>
  </sequential>

  <task id="urn:oodt:e2e:Guarded" name="Guarded"
        class="org.apache.oodt.cas.workflow.engine.RecordingTask">
    <conditions/>
    <configuration>
      <property name="RecordAs" value="guarded"/>
    </configuration>
  </task>

  <task id="urn:oodt:e2e:GuardedTask" name="Guarded Task"
        class="org.apache.oodt.cas.workflow.engine.RecordingTask">
    <conditions>
      <condition id-ref="urn:oodt:e2e:Gate"/>
    </conditions>
    <configuration>
      <property name="RecordAs" value="guarded-task"/>
    </configuration>
  </task>

  <condition id="urn:oodt:e2e:Gate" name="Gate"
             class="org.apache.oodt.cas.workflow.engine.GateCondition"/>

</cas:workflows>
