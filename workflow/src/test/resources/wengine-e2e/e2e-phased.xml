<!--
  The three phases a workflow has always claimed to have: preconditions, then
  tasks, then post-conditions.

  Both conditions blocks matter. Only the first used to be read at all, and the
  type attribute was ignored, so everything written here became a precondition
  and ran beside the work instead of around it.
-->
<cas:workflows xmlns="http://oodt.jpl.nasa.gov/2.0/cas"
  xmlns:cas="http://oodt.jpl.nasa.gov/2.0/cas">

  <sequential id="urn:oodt:e2e:Phased" name="Phased">
    <conditions type="pre">
      <condition id-ref="urn:oodt:e2e:BeforeGate"/>
    </conditions>
    <task id-ref="urn:oodt:e2e:PhaseWork"/>
    <conditions type="post">
      <condition id-ref="urn:oodt:e2e:AfterGate"/>
    </conditions>
  </sequential>

  <task id="urn:oodt:e2e:PhaseWork" name="Phase Work"
        class="org.apache.oodt.cas.workflow.engine.RecordingTask">
    <configuration>
      <property name="RecordAs" value="work"/>
    </configuration>
  </task>

  <condition id="urn:oodt:e2e:BeforeGate" name="Before Gate"
             class="org.apache.oodt.cas.workflow.engine.GateCondition">
    <configuration>
      <property name="RecordAs" value="before"/>
    </configuration>
  </condition>

  <condition id="urn:oodt:e2e:AfterGate" name="After Gate"
             class="org.apache.oodt.cas.workflow.engine.GateCondition">
    <configuration>
      <property name="RecordAs" value="after"/>
    </configuration>
  </condition>

</cas:workflows>
